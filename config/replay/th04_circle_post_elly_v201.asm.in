; Replay integration wrapper for the v201 post-Elly CIRCLE_TEXT suffix.
;
; This wrapper owns no recovered target body. It only aggregates five maintained
; symbolic assembly sources whose physical owners were accepted independently in
; v198-v200, so the natural Elly callback can become its own TC4J object without
; copying target-derived bytes into a replay-only suffix.
{{EXTRACTED_SPAN}}
	.386
	.model use16 large _TEXT
include ReC98.inc
include th04/th04.inc
include th01/math/subpixel.inc
include th02/main/sparks.inc
include th04/sprites/main_pat.inc
include th04/sprites/main_cdg.inc
include th04/sprites/blit.inc
include th04/main/phase.inc
include th04/main/tile/tile.inc
include th04/hardware/grcg.inc

extrn GRCG_SETCOLOR:proc
extrn _tiles_bb_col:byte
extrn _tiles_bb_seg:word
extrn _bb_boss_seg:word
extrn _tile_invalidate_box:Point
extrn _scroll_active:byte
extrn _scroll_line:word
extrn @grcg_tile_bb_put_8:near
extrn TILES_INVALIDATE_AROUND:near
extrn _grcg_fill_playfield_rows:near
extrn _super_patdata:word
extrn _bb_txt_seg:word

CIRCLE_TEXT segment word public 'CODE' use16
CIRCLE_TEXT ends
main_01 group CIRCLE_TEXT

CIRCLE_TEXT segment word public 'CODE' use16
assume cs:main_01
include th04/hardware/fillm64-56_256-256.asm
include th04/main/tile/bb_put_a.asm
include th04/main/boss/yuuka5_backdrop.asm
include th04/formats/z_super_put_16x16_mono.asm
include th04/formats/bb_txt_put.asm
CIRCLE_TEXT ends
end
