KURUMI_SPAWNRAY_COUNT = 6
B2SF_FREE = 0
B2SF_GROW = 1
B2SF_SHRINK = 2
kurumi_spawnray_t struc
    B2S_flag db ?
        db ?
    B2S_target Point <?>
    B2S_origin Point <?>
    B2S_velocity Point <?>
        db 12 dup(?)
kurumi_spawnray_t ends
