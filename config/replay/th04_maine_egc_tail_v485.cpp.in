#include "planar.h"
#include "libs/master.lib/pc98_gfx.hpp"
#include "x86real.h"
#include "decomp.hpp"

#pragma codeseg SCORE_TEXT score_01
void near score_egc_start_copy(void)
{
	_outportb_(0x7C, 0);
	_outportb_(0x6A, 7);
	_outportb_(0x6A, 5);
	_outportb_(0x7C, 0x80);
	_outportb_(0x6A, 6);

	_AX = 0xFFF0; _DX = EGC_ACTIVEPLANEREG; outport(_DX, _AX);
	_AX = 0x00FF; _DX = EGC_READPLANEREG;  outport(_DX, _AX);
	_AX = 0x3100; _DX = EGC_MODE_ROP_REG;   outport(_DX, _AX);
	_AX = 0xFFFF; _DX = EGC_MASKREG;       outport(_DX, _AX);
	_AX = keep_0(0); _DX = EGC_ADDRRESSREG; outport(_DX, _AX);
	_AX = 0x000F; _DX = EGC_BITLENGTHREG;  outport(_DX, _AX);
}

void pascal near score_rect_copy(int left, int top, int w, int h)
{
	int x;
	int y;
	vram_offset_t vo;
	dots16_t dots;
	register vram_offset_t vo_r;
	register int word_w = w;

	score_egc_start_copy();
	vo = ((left >> 3) + (top << 6) + (top << 4));
	word_w /= 16;
	for(y = 0; y < h; y++, vo += ROW_SIZE) {
		x = 0;
		vo_r = vo;
		for(; x < word_w; x++, vo_r += 2) {
			_DX = 0xA6;
			outportb(_DX, 1);
			dots = *reinterpret_cast<dots16_t far *>(VRAM_PLANE_B + vo_r);
			outportb(_DX, 0);
			*reinterpret_cast<dots16_t far *>(VRAM_PLANE_B + vo_r) = dots;
		}
	}
	egc_off();
}
#pragma codeseg
