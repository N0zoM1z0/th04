 pos motion_t <?>
 patnum_base dw ?
 damage db ?
 SHOT_angle db ?
shot_t ends
HITSHOT_FRAMES_PER_CEL = 4
SHOT_COUNT = 68
HITSHOT_FRAMES = (HITSHOT_CELS * HITSHOT_FRAMES_PER_CEL)
SF_FREE = 0
SF_ALIVE = 1
SF_HIT = 2
SF_REMOVE = (SF_HIT + HITSHOT_FRAMES)
SHOT_LASER_COOLDOWN_FRAMES = 32
SHOT_W = 16
SHOT_H = 16

shot_alive_t struct
 SA_pos Point <?>
 SA_shot dw ?
shot_alive_t ends

ENEMY_W = 32
ENEMY_H = 32
EF_FREE = 0
EF_ALIVE = 1
EF_KILLED = 2
EF_ALIVE_FIRST_FRAME = 3
EF_KILL_ANIM = 80h
