; Replay-only CIRCLE_TEXT render-residual wrapper for v188.
; The extracted body remains target-derived scaffold and receives zero reconstruction credit.
	.386
	.model use16 large _TEXT
include ReC98.inc
include th04/th04.inc
include th01/math/subpixel.inc
include th02/main/sparks.inc
include th04/sprites/main_pat.inc
include th04/sprites/main_cdg.inc
include th04/sprites/blit.inc
include th04/main/phase.inc
include th04/main/tile/tile.inc
include th04/hardware/grcg.inc
include th04/main/spark.inc

item_splash_t struc
	flag db ?
	db ?
	center Point ?
	radius_cur dw ?
	radius_prev dw ?
item_splash_t ends
ITEM_SPLASH_COUNT = 8
ITEM_SPLASH_DOTS = 64

extrn _item_splashes:byte
extrn _drawpoint:Point
extrn _sSPARKS:byte
extrn _sparks:byte
extrn _tile_invalidate_box:Point
extrn _spark_ring_offset:byte
extrn _playperf:byte
extrn _playperf_max:byte
extrn _playperf_min:byte
extrn _rank:byte
extrn super_patdata:word
extern VECTOR2_AT:proc
extrn SCROLL_SUBPIXEL_Y_TO_VRAM_SEG1:near
extrn @PlayfieldMotion@update_seg1$qv:near
extrn TILES_INVALIDATE_AROUND:near
extrn _grcg_fill_playfield_rows:near
extrn @grcg_setcolor_direct_raw$qv:near
extrn IRAND:far

CIRCLE_TEXT segment word public 'CODE' use16
CIRCLE_TEXT ends
main_01 group CIRCLE_TEXT

CIRCLE_TEXT segment word public 'CODE' use16
assume cs:main_01
{{EXTRACTED_SPAN}}
CIRCLE_TEXT ends
end
