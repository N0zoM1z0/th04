include th04/main/enemy/enemy.inc
BOMB_STAR_COUNT = 48
BOMB_STAR_W = 16
BOMB_STAR_H = 16
bomb_star_t struc
 BS_center Point <?>
 BS_angle db ?
 BS_speed db ?
bomb_star_t ends

shot_t struc
